#!/bin/sh
# Managed by Ansible (roles/observability_agent). Local edits are overwritten.
#
# Writes a one-line OTLP/JSON snapshot of this Mac's SSH access state for the
# collector's otlp_json_file receiver. Run by launchd every
# {{ otel_ssh_check_interval }}s as the per-user LaunchAgent {{ otel_ssh_state_launchd_label }}.
#
# Runs as the unprivileged deployment user (LaunchAgent / no-sudo variant).
# Read-only: it runs launchctl print, netstat, nc, ps and who, and records
# only the fields listed below. It never reads terminal contents, commands,
# keys, environment variables or the sshd log.
#
#   ssh.remote_login.enabled  launchd has {{ otel_ssh_launchd_label }} loaded (Remote Login on)
#   ssh.port.listening        something is listening on TCP {{ otel_ssh_port }}
#   ssh.service.up            sshd answered on loopback with an SSH protocol banner
#   ssh.sessions              authenticated SSH sessions this script could attribute
#   ssh.connections           established TCP connections on port {{ otel_ssh_port }}, any
#                             user, including ones not yet authenticated
#   ssh.session.start_time    one series per attributed session (user, source
#                             address, tty, sshd pid), value = login time in unix seconds
#
# macOS runs sshd socket-activated: launchd owns the listening socket and
# spawns sshd per connection, so port {{ otel_ssh_port }} reads as open even if sshd
# itself is broken. Only a banner proves sshd actually runs.
#
# A session is an sshd process titled "sshd: <user>@<tty>" or, on OpenSSH 9.8+,
# "sshd-session: <user>@<tty>" (tty is "notty" for scp/sftp/remote commands).
# Only post-authentication sshd processes carry that title, and local console
# or Terminal logins have no sshd process at all. To be counted, the process
# (or its privileged parent) must also own an established connection on the
# SSH port, which is where the source address comes from -- or, failing that,
# have a matching utmpx login record (who) with a remote host, which only a
# login service such as sshd can write.
#
# Unprivileged visibility (what replaced the root-only lsof of the system-level
# variant):
#   - launchctl print system/<label>, netstat and `ps -o command` work for any
#     user on macOS, including for root's and other users' processes.
#   - lsof cannot see other users' sockets, so socket ownership comes from
#     `netstat -anv`, whose process:pid (or pid) column covers every socket.
#   - A session whose socket shows no sshd pid and that has no utmpx record
#     (typically another user's scp/sftp/notty session) is not attributed; it
#     still appears in ssh.connections. ssh.connections > ssh.sessions means
#     part of the picture is unattributed, not that nothing is there.

set -u
PATH=/usr/bin:/bin:/usr/sbin:/sbin
LC_ALL=C
export PATH LC_ALL
umask 077

state_dir='{{ otel_ssh_state_dir }}'
ssh_port='{{ otel_ssh_port }}'
launchd_label='{{ otel_ssh_launchd_label }}'
banner_timeout='{{ otel_ssh_banner_timeout }}'
session_details='{{ 1 if otel_ssh_session_details_enabled | bool else 0 }}'

now=$(date +%s)

# Unprivileged: launchctl answers print requests for the system domain.
if launchctl print "system/${launchd_label}" >/dev/null 2>&1; then
    enabled=1
else
    enabled=0
fi

if netstat -an -p tcp 2>/dev/null |
    awk -v port="${ssh_port}" '$6 == "LISTEN" && $4 ~ ("[.:]" port "$") { found = 1 } END { exit !found }'; then
    listening=1
else
    listening=0
fi

up=0
if [ "${listening}" -eq 1 ]; then
    banner=$(nc -G "${banner_timeout}" -w "${banner_timeout}" 127.0.0.1 "${ssh_port}" </dev/null 2>/dev/null | head -n 1)
    case "${banner}" in
        SSH-2.0-* | SSH-1.99-*) up=1 ;;
    esac
fi

# pid ppid user tty elapsed-seconds, one line per authenticated session.
sessions=$(ps -axww -o pid=,ppid=,etime=,command= 2>/dev/null | awk '
    NF == 5 && $4 ~ /^sshd(-session)?:$/ && $5 ~ /^[^@]+@[^@]+$/ {
        split($5, who, "@")
        n = split($3, t, /[-:]/)
        secs = t[n] + t[n - 1] * 60
        if (n >= 3) secs += t[n - 2] * 3600
        if (n == 4) secs += t[1] * 86400
        print $1, $2, who[1], who[2], secs
    }')

# pid remote-address for every established connection on the SSH port. pid is
# "-" when netstat names none. Recent macOS prints a process:pid column (the
# process name may contain spaces, so the first name:pid field is taken);
# older releases print a bare pid column, located from the header. Header
# fields "Local Address" and "Foreign Address" are two words each, so a data
# column sits two fields left of its header.
connections=$(netstat -anv -p tcp 2>/dev/null | awk -v port="${ssh_port}" '
    $1 == "Proto" {
        for (i = 1; i <= NF; i++) {
            if ($i == "process:pid") named = 1
            else if ($i == "pid" && !pidcol) pidcol = i - 2
        }
        next
    }
    $1 ~ /^tcp/ && $6 == "ESTABLISHED" && $4 ~ ("[.]" port "$") {
        pid = "-"
        if (named) {
            for (i = 11; i <= NF; i++) if ($i ~ /:[0-9]+$/) { pid = $i; sub(/.*:/, "", pid); break }
        } else if (pidcol && $pidcol ~ /^[0-9]+$/) {
            pid = $pidcol
        }
        remote = $5
        sub(/[.][0-9]+$/, "", remote)
        print pid, remote
    }')

# user tty host from utmpx (world-readable, written only by login services).
# Covers terminal sessions; scp/sftp/notty sessions have no utmpx record. Only
# records with a remote host are used: sshd always sets one, while a local
# console or Terminal login has none.
logins=$(who 2>/dev/null | awk '{ host = ($NF ~ /^\(.*\)$/) ? substr($NF, 2, length($NF) - 2) : ""; print $1, $2, host }')

# The timestamp must stay within the first 1000 bytes (the receiver's file
# fingerprint): it is what makes each snapshot a new file to otlp_json_file,
# so every snapshot is read exactly once.
{
    printf '%s\n' "${connections}" | sed 's/^/A /'
    printf '%s\n' "${logins}" | sed 's/^/U /'
    printf '%s\n' "${sessions}" | sed 's/^/S /'
} | awk -v now="${now}" -v enabled="${enabled}" -v listening="${listening}" -v up="${up}" -v details="${session_details}" '
    function clean(value, allowed) { gsub("[^" allowed "]", "", value); return value == "" ? "unknown" : value }
    function attr(key, value) { return "{\"key\":\"" key "\",\"value\":{\"stringValue\":\"" value "\"}}" }
    function gauge(name, unit, description, points) {
        return "{\"name\":\"" name "\",\"unit\":\"" unit "\",\"description\":\"" description "\",\"gauge\":{\"dataPoints\":[" points "]}}"
    }
    function point(value, attrs) { return "{\"timeUnixNano\":\"" now "000000000\",\"asInt\":\"" value "\"" (attrs == "" ? "" : ",\"attributes\":[" attrs "]") "}" }
    $1 == "A" && NF == 3 { connections++; if ($2 != "-") address[$2] = $3 }
    $1 == "U" && NF >= 3 { login[$2 SUBSEP $3] = (NF == 4 ? $4 : "") }
    $1 == "S" && NF == 6 {
        if ($2 in address) source = address[$2]
        else if ($3 in address) source = address[$3]
        else if ($5 != "notty" && login[$4 SUBSEP $5] != "") source = login[$4 SUBSEP $5]
        else next
        count++
        if (details == 1) {
            attrs = attr("user.name", clean($4, "A-Za-z0-9._-")) "," attr("source.address", clean(source, "0-9A-Za-z.:%-")) "," attr("ssh.session.tty", clean($5, "A-Za-z0-9,")) "," attr("ssh.session.id", clean($2, "0-9"))
            sessions = sessions (sessions == "" ? "" : ",") point(now - $6, attrs)
        }
    }
    END {
        metrics = gauge("ssh.remote_login.enabled", "", "1 if launchd has the sshd job loaded (Remote Login on).", point(enabled, ""))
        metrics = metrics "," gauge("ssh.port.listening", "", "1 if the SSH port is listening.", point(listening, ""))
        metrics = metrics "," gauge("ssh.service.up", "", "1 if sshd answered with an SSH protocol banner on loopback.", point(up, ""))
        metrics = metrics "," gauge("ssh.sessions", "{session}", "Authenticated SSH sessions attributed by an unprivileged collector.", point(count + 0, ""))
        metrics = metrics "," gauge("ssh.connections", "{connection}", "Established TCP connections on the SSH port, any user.", point(connections + 0, ""))
        if (sessions != "") metrics = metrics "," gauge("ssh.session.start_time", "s", "Login time of each live SSH session.", sessions)
        printf "{\"resourceMetrics\":[{\"resource\":{},\"scopeMetrics\":[{\"scope\":{\"name\":\"observability.ssh_state\"},\"metrics\":[%s]}]}]}\n", metrics
    }' >"${state_dir}/ssh-state.json.tmp" &&
    mv -f "${state_dir}/ssh-state.json.tmp" "${state_dir}/ssh-state.json"
