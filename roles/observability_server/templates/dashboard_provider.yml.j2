# Managed by Ansible (roles/observability_server). One Grafana folder per
# sub-directory (Fleet, LLM, Platform): see observability_server_dashboards.
apiVersion: 1
providers:
  - name: 'Observability Dashboards'
    orgId: 1
    type: file
    disableDeletion: false
    allowUiUpdates: false
    updateIntervalSeconds: 30
    options:
      path: {{ etc_dir }}/grafana/provisioning/dashboards
      foldersFromFilesStructure: true
