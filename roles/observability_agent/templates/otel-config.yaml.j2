# Managed by Ansible (roles/observability_agent). Local edits are overwritten.
{% if victoriametrics_auth_enabled %}
extensions:
  basicauth/victoriametrics:
    client_auth:
      username: "{{ victoriametrics_auth_username }}"
      password: "{{ victoriametrics_auth_password }}"

{% endif %}
receivers:
  hostmetrics:
    collection_interval: {{ otel_collection_interval }}
    scrapers:
      cpu:
      memory:
      disk:
      filesystem:
        # macOS/APFS: sibling volumes in one container all report the same
        # container-wide capacity, so scraping them all multiplies series
        # without adding signal. "/" and "/System/Volumes/Data" are kept.
        exclude_mount_points:
          match_type: regexp
          mount_points:
{% for mount_point in otel_filesystem_exclude_mount_points %}
            - '{{ mount_point }}'
{% endfor %}
        exclude_fs_types:
          match_type: strict
          fs_types:
{% for fs_type in otel_filesystem_exclude_fs_types %}
            - {{ fs_type }}
{% endfor %}
      network:
      load:
{% if otel_latency_check_enabled | bool %}

  # TCP connect time to VictoriaMetrics = network round-trip latency from this
  # Mac to the monitoring Mac. Needs no credentials, so it is unaffected by
  # victoriametrics_auth_enabled.
  tcp_check/monitoring_server:
    collection_interval: {{ otel_collection_interval }}
    targets:
      - endpoint: "{{ monitoring_server_address }}:{{ victoriametrics_port }}"
{% endif %}
{% if otel_ssh_monitoring_enabled | bool %}

  # SSH access state written by com.observability.sshstate. Each snapshot is
  # atomically replaced and carries a fresh timestamp in its first bytes, so
  # the receiver reads each one exactly once; exclude_older_than stops a stale
  # snapshot being re-read after a collector restart.
  otlp_json_file/ssh_state:
    include: ["{{ otel_ssh_state_dir }}/ssh-state.json"]
    start_at: beginning
    poll_interval: 5s
    exclude_older_than: {{ (otel_ssh_check_interval | int) * 3 }}s
{% endif %}

processors:
  batch:
    timeout: 1s
    send_batch_size: 1024
  resourcedetection:
    detectors: [system]
    system:
      hostname_sources: [os]

exporters:
  otlphttp:
    metrics_endpoint: "http://{{ monitoring_server_address }}:{{ victoriametrics_port }}/opentelemetry/v1/metrics"
{% if victoriametrics_auth_enabled %}
    auth:
      authenticator: basicauth/victoriametrics
{% endif %}

service:
{% if victoriametrics_auth_enabled %}
  extensions: [basicauth/victoriametrics]
{% endif %}
  pipelines:
    metrics:
      receivers: [hostmetrics{{ ', tcp_check/monitoring_server' if otel_latency_check_enabled | bool else '' }}{{ ', otlp_json_file/ssh_state' if otel_ssh_monitoring_enabled | bool else '' }}]
      processors: [resourcedetection, batch]
      exporters: [otlphttp]
