{#- Managed by Ansible. Panel builders shared by the three LLM dashboards
    (llm_*.json.j2), imported with {% import 'llm_dashboard_macros.j2' as m %}.
    Every string goes through tojson, so PromQL is written with plain double
    quotes and never hand-escaped. Grafana legend syntax is produced by lg(),
    because a literal double-brace would be read as a Jinja expression.

    All panels use the existing VictoriaMetrics datasource (uid victoriametrics).
    noValue texts say why a panel is empty instead of showing a fake zero. -#}
{% set ds = {"type": "prometheus", "uid": "victoriametrics"} %}

{%- macro lg(name) -%}{{ '{{' }}{{ name }}{{ '}}' }}{%- endmacro %}

{%- macro steps(spec) -%}
[{% for color, value in spec %}{"color": {{ color | tojson }}, "value": {{ value | tojson }}}{{ '' if loop.last else ', ' }}{% endfor %}]
{%- endmacro %}

{%- macro targets(exprs, instant=false, table=false) -%}
[{% for t in exprs %}{"refId": {{ "ABCDEFGHIJ"[loop.index0] | tojson }}, "datasource": {{ ds | tojson }}, "expr": {{ t.expr | tojson }}, "legendFormat": {{ t.legend | default('') | tojson }}{% if instant %}, "instant": true, "range": false{% else %}, "range": true{% endif %}{% if table %}, "format": "table"{% endif %}}{{ '' if loop.last else ', ' }}{% endfor %}]
{%- endmacro %}

{%- macro row(id, title, y) -%}
{"id": {{ id }}, "type": "row", "title": {{ title | tojson }}, "collapsed": false, "gridPos": {"x": 0, "y": {{ y }}, "w": 24, "h": 1}, "panels": []}
{%- endmacro %}

{%- macro stat(id, title, expr, x, y, w=3, h=4, unit="short", desc="", spec=[["green", None]], decimals=None, no_value="No data", mappings=[], legend="", text_mode="value", color_mode="value", type="stat", min=None, max=None, extra=[]) -%}
{
  "id": {{ id }}, "type": {{ type | tojson }}, "title": {{ title | tojson }}, "description": {{ desc | tojson }},
  "datasource": {{ ds | tojson }},
  "gridPos": {"x": {{ x }}, "y": {{ y }}, "w": {{ w }}, "h": {{ h }}},
  "options": {"reduceOptions": {"calcs": ["lastNotNull"], "fields": "", "values": false}, "orientation": "auto", "textMode": {{ text_mode | tojson }}, "colorMode": {{ color_mode | tojson }}, "graphMode": "none", "justifyMode": "auto", "showThresholdLabels": false, "showThresholdMarkers": true},
  "fieldConfig": {"defaults": {"unit": {{ unit | tojson }}, "noValue": {{ no_value | tojson }}{% if decimals is not none %}, "decimals": {{ decimals }}{% endif %}{% if min is not none %}, "min": {{ min }}{% endif %}{% if max is not none %}, "max": {{ max }}{% endif %}, "color": {"mode": "thresholds"}, "thresholds": {"mode": "absolute", "steps": {{ steps(spec) }}}, "mappings": {{ mappings | tojson }}}, "overrides": []},
  "targets": {{ targets([{"expr": expr, "legend": legend}] + extra, instant=true) }}
}
{%- endmacro %}

{%- macro ts(id, title, exprs, x, y, w=12, h=8, unit="short", desc="", no_value="No data", min=None, max=None, stack=false, overrides=[], decimals=None, draw="line") -%}
{
  "id": {{ id }}, "type": "timeseries", "title": {{ title | tojson }}, "description": {{ desc | tojson }},
  "datasource": {{ ds | tojson }},
  "gridPos": {"x": {{ x }}, "y": {{ y }}, "w": {{ w }}, "h": {{ h }}},
  "options": {"legend": {"displayMode": "list", "placement": "bottom", "showLegend": true}, "tooltip": {"mode": "multi", "sort": "desc"}},
  "fieldConfig": {"defaults": {"unit": {{ unit | tojson }}, "noValue": {{ no_value | tojson }}{% if decimals is not none %}, "decimals": {{ decimals }}{% endif %}{% if min is not none %}, "min": {{ min }}{% endif %}{% if max is not none %}, "max": {{ max }}{% endif %}, "custom": {"drawStyle": {{ draw | tojson }}, "lineWidth": 1, "fillOpacity": {{ 25 if stack else 10 }}, "showPoints": "never", "spanNulls": false, "stacking": {"mode": {{ ('normal' if stack else 'none') | tojson }}, "group": "A"}}}, "overrides": {{ overrides | tojson }}},
  "targets": {{ targets(exprs) }}
}
{%- endmacro %}

{%- macro table(id, title, exprs, x, y, w=24, h=8, desc="", no_value="No data", organize={}, overrides=[]) -%}
{
  "id": {{ id }}, "type": "table", "title": {{ title | tojson }}, "description": {{ desc | tojson }},
  "datasource": {{ ds | tojson }},
  "gridPos": {"x": {{ x }}, "y": {{ y }}, "w": {{ w }}, "h": {{ h }}},
  "options": {"showHeader": true, "cellHeight": "sm"},
  "fieldConfig": {"defaults": {"noValue": {{ no_value | tojson }}}, "overrides": {{ overrides | tojson }}},
  "targets": {{ targets(exprs, instant=true, table=true) }},
  "transformations": [{"id": "merge", "options": {}}, {"id": "organize", "options": {{ organize | tojson }}}]
}
{%- endmacro %}

{%- macro text(id, title, content, x, y, w=24, h=4) -%}
{
  "id": {{ id }}, "type": "text", "title": {{ title | tojson }},
  "gridPos": {"x": {{ x }}, "y": {{ y }}, "w": {{ w }}, "h": {{ h }}},
  "options": {"mode": "markdown", "content": {{ content | tojson }}}
}
{%- endmacro %}

{#- A hardware reading the agent reports as collected (1) or unavailable (0)
    for every node, via macos_hardware_metric_available{metric=...}. -#}
{%- macro availability(id, title, metric, reason, x, y, w=3, h=4, host_filter='host_name=~"$host"') -%}
{{ stat(id, title, 'min(macos_hardware_metric_available{metric="' ~ metric ~ '", ' ~ host_filter ~ '})', x, y, w=w, h=h,
        desc=reason, no_value="No LLM telemetry", spec=[["text", None]], text_mode="value",
        mappings=[{"type": "value", "options": {"0": {"text": "Unavailable", "color": "text"}, "1": {"text": "Collected", "color": "green"}}}]) }}
{%- endmacro %}

{#- Shared value mappings. -#}
{% set up_down = [{"type": "value", "options": {"0": {"text": "Down", "color": "red"}, "1": {"text": "Up", "color": "green"}}}] %}
{% set pressure_map = [{"type": "value", "options": {"0": {"text": "Normal", "color": "green"}, "1": {"text": "Warning", "color": "orange"}, "2": {"text": "Critical", "color": "red"}}}] %}
{% set thermal_map = [{"type": "value", "options": {"0": {"text": "Nominal", "color": "green"}, "1": {"text": "Fair", "color": "yellow"}, "2": {"text": "Serious", "color": "orange"}, "3": {"text": "Critical", "color": "red"}}}] %}
