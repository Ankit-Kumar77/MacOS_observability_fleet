{#- Managed by Ansible. LLM Node Detail: one Mac's host health and the MLX-LM
    server on it. $host is single-value (set by ?var-host=<host> from the
    overview); $model filters request panels. Metric definitions:
    docs/LLM_OBSERVABILITY.md. -#}
{% import 'llm_dashboard_macros.j2' as m %}
{% set H = 'host_name="$host"' %}
{% set F = 'host_name="$host", model=~"$model"' %}
{% set proxy0 = ' or on() (0 * sum(mlx_telemetry_info{' ~ H ~ ', proxy="enabled"}))' %}
{% set ri = '[$__rate_interval]' %}
{%- macro hq(quantile, metric, window='[$__rate_interval]') -%}
histogram_quantile({{ quantile }}, sum by (le) (rate({{ metric }}_bucket{ {{- F -}} }{{ window }})))
{%- endmacro %}
{% set cpu_busy = '100 * (1 - sum(rate(system_cpu_time_seconds_total{state="idle", ' ~ H ~ '}' ~ ri ~ ')) / sum(rate(system_cpu_time_seconds_total{' ~ H ~ '}' ~ ri ~ ')))' %}
{% set mem_used_pct = 'sum(system_memory_usage_bytes{state="used", ' ~ H ~ '}) / sum(system_memory_usage_bytes{' ~ H ~ '}) * 100' %}
{% set disk_used_pct = 'sum(system_filesystem_usage_bytes{state="used", mountpoint="/", ' ~ H ~ '}) / sum(system_filesystem_usage_bytes{mountpoint="/", ' ~ H ~ '}) * 100' %}
{
  "uid": "{{ grafana_llm_node_dashboard_uid }}",
  "title": "LLM Node Detail",
  "description": "One Mac Mini: host health plus the MLX-LM server measured by the MLX telemetry agent.",
  "tags": ["llm", "mlx", "otel"],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "refresh": "30s",
  "time": {"from": "now-3h", "to": "now"},
  "links": [
    {"type": "link", "title": "LLM Cluster Overview", "url": "/d/{{ grafana_llm_overview_dashboard_uid }}", "icon": "dashboard", "includeVars": false, "keepTime": true, "targetBlank": false, "asDropdown": false, "tags": []},
    {"type": "link", "title": "LLM Performance, KV Cache and Quality", "url": "/d/{{ grafana_llm_performance_dashboard_uid }}", "icon": "dashboard", "includeVars": true, "keepTime": true, "targetBlank": false, "asDropdown": false, "tags": []},
    {"type": "link", "title": "Mac Mini Detail (host metrics)", "url": "/d/{{ grafana_detail_dashboard_uid }}?var-host_name=${host}", "icon": "dashboard", "includeVars": false, "keepTime": true, "targetBlank": false, "asDropdown": false, "tags": []}
  ],
  "templating": {
    "list": [
      {
        "name": "host", "label": "Host", "type": "query",
        "description": "Macs that run the MLX telemetry agent.",
        "datasource": {{ m.ds | tojson }},
        "definition": "label_values(mlx_telemetry_info, host_name)",
        "query": {"qryType": 1, "query": "label_values(mlx_telemetry_info, host_name)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 2, "regex": "", "sort": 1, "multi": false, "includeAll": false,
        "current": {}, "options": [], "hide": 0
      },
      {
        "name": "model", "label": "Model", "type": "query",
        "datasource": {{ m.ds | tojson }},
        "definition": "label_values(mlx_model_info{host_name=\"$host\"}, model)",
        "query": {"qryType": 1, "query": "label_values(mlx_model_info{host_name=\"$host\"}, model)", "refId": "PrometheusVariableQueryEditor-VariableQuery"},
        "refresh": 2, "regex": "", "sort": 1, "multi": true, "includeAll": true, "allValue": ".*",
        "current": {"selected": true, "text": ["All"], "value": ["$__all"]}, "options": [], "hide": 0
      }
    ]
  },
  "panels": [
    {{ m.row(1, "Status", 0) }},
    {{ m.stat(2, "Node", 'max by (host_name) (mlx_telemetry_info{' ~ H ~ '})', 0, 1, w=4, legend=m.lg('host_name'), text_mode="name", color_mode="none",
        desc="Host name as reported by the collector.", no_value="No LLM telemetry") }},
    {{ m.stat(3, "Model served", 'max by (model) (mlx_model_info{' ~ H ~ '})', 4, 1, w=5, legend=m.lg('model'), text_mode="name", color_mode="none",
        desc="--model argument of the running mlx_lm.server (a path is reduced to its last component), llm_model_name, or the single model /v1/models lists.", no_value="Not detected") }},
    {{ m.stat(4, "MLX-LM /health", 'max(mlx_server_up{' ~ H ~ '})', 9, 1, w=3, mappings=m.up_down, spec=[["red", None], ["green", 1]], color_mode="background",
        desc="Last /health check: 200 = Up.", no_value="No LLM telemetry") }},
    {{ m.stat(5, "MLX-LM process", 'max(mlx_process_up{' ~ H ~ '})', 12, 1, w=3, mappings=m.up_down, spec=[["red", None], ["green", 1]], color_mode="background",
        desc="An mlx_lm.server process was found (by mlx_launchagent_label or by mlx_process_pattern).", no_value="No LLM telemetry") }},
    {{ m.stat(6, "Since last health OK", 'time() - max(mlx_health_last_success_timestamp_seconds{check="http", ' ~ H ~ '})', 15, 1, w=3, unit="s", decimals=0,
        spec=[["green", None], ["orange", 60], ["red", 300]], desc="Seconds since /health last answered 200.", no_value="Never succeeded") }},
    {{ m.stat(7, "Requests (5m)", 'sum(increase(mlx_requests_total{' ~ F ~ '}[5m]))' ~ proxy0, 18, 1, w=3, decimals=0,
        desc="Requests through the telemetry proxy in the last 5 minutes.", no_value="No proxy telemetry") }},
    {{ m.stat(8, "Telemetry age", 'time() - max(timestamp(mlx_telemetry_up{' ~ H ~ '}))', 21, 1, w=3, unit="s", decimals=0,
        spec=[["green", None], ["orange", 60], ["red", 120]], desc="Seconds since the newest LLM telemetry sample.", no_value="No LLM telemetry") }},

    {{ m.row(9, "Hardware", 5) }},
    {{ m.stat(10, "Load (1m)", 'max(system_cpu_load_average_1m{' ~ H ~ '})', 0, 6, w=3, h=5, type="gauge", decimals=2, min=0, max=8,
        spec=[["green", None], ["orange", 4], ["red", 8]], desc="Existing host metrics.") }},
    {{ m.stat(11, "Memory used", mem_used_pct, 3, 6, w=3, h=5, type="gauge", unit="percent", decimals=1, min=0, max=100,
        spec=[["green", None], ["orange", 80], ["red", 90]], desc="Existing host metrics; inactive memory is not counted as used.") }},
    {{ m.stat(12, "Memory pressure", 'max(macos_memory_pressure_level{' ~ H ~ '})', 6, 6, w=3, h=5, mappings=m.pressure_map,
        spec=[["green", None], ["orange", 1], ["red", 2]], color_mode="background", desc="Kernel memory pressure level (sysctl kern.memorystatus_vm_pressure_level).", no_value="Not collected") }},
    {{ m.stat(13, "MLX-LM footprint", 'max(mlx_process_memory_footprint_bytes{' ~ H ~ '})', 9, 6, w=3, h=5, unit="bytes", decimals=1,
        desc="Physical footprint of the MLX-LM process, including Metal buffers (weights, KV cache). RSS is shown in the time series below.", no_value="Process not found") }},
    {{ m.stat(14, "Disk used (/)", disk_used_pct, 12, 6, w=3, h=5, type="gauge", unit="percent", decimals=1, min=0, max=100,
        spec=[["green", None], ["orange", 80], ["red", 90]], desc="Existing host metrics.") }},
    {{ m.stat(15, "GPU utilisation", 'max(macos_gpu_utilization_percent{' ~ H ~ '})', 15, 6, w=3, h=5, type="gauge", unit="percent", decimals=0, min=0, max=100,
        spec=[["green", None], ["orange", 80], ["red", 95]], desc="IORegistry AGX Device Utilization % (unprivileged, undocumented key).", no_value="Not collected") }},
    {{ m.stat(16, "GPU memory in use", 'max(macos_gpu_memory_in_use_bytes{' ~ H ~ '})', 18, 6, w=3, h=5, unit="bytes", decimals=1,
        desc="Unified memory the GPU driver reports in use (IORegistry).", no_value="Not collected") }},
    {{ m.stat(17, "Thermal state", 'max(macos_thermal_state{' ~ H ~ '})', 21, 6, w=3, h=5, mappings=m.thermal_map,
        spec=[["green", None], ["yellow", 1], ["orange", 2], ["red", 3]], color_mode="background", desc="NSProcessInfo.thermalState.", no_value="Not collected") }},
    {{ m.availability(18, "GPU frequency", "gpu_frequency", "Not collected: needs powermetrics (root) or the private IOReport API.", 0, 11, w=6, h=3, host_filter=H) }},
    {{ m.availability(19, "CPU / GPU / ANE power", "gpu_power", "Not collected: needs powermetrics (root) or the private IOReport API.", 6, 11, w=6, h=3, host_filter=H) }},
    {{ m.availability(20, "GPU utilisation source", "gpu_utilization", "Whether this node's GPU utilisation is collected (IORegistry).", 12, 11, w=6, h=3, host_filter=H) }},
    {{ m.availability(21, "Thermal state source", "thermal_state", "Whether this node's thermal state is collected (NSProcessInfo).", 18, 11, w=6, h=3, host_filter=H) }},

    {{ m.row(22, "Hardware over time", 14) }},
    {{ m.ts(23, "CPU busy and load", [{"expr": cpu_busy, "legend": "CPU busy %"}, {"expr": 'max(system_cpu_load_average_1m{' ~ H ~ '})', "legend": "load 1m"}], 0, 15, w=8, unit="percent",
        desc="Existing host metrics.", min=0,
        overrides=[{"matcher": {"id": "byName", "options": "load 1m"}, "properties": [{"id": "unit", "value": "short"}, {"id": "custom.axisPlacement", "value": "right"}]}]) }},
    {{ m.ts(24, "System memory", [{"expr": 'sum by (state) (system_memory_usage_bytes{' ~ H ~ '})', "legend": m.lg('state')}], 8, 15, w=8, unit="bytes", stack=true,
        desc="Existing host metrics by state (free / inactive / used).", min=0) }},
    {{ m.ts(25, "Memory pressure level", [{"expr": 'max(macos_memory_pressure_level{' ~ H ~ '})', "legend": "pressure"}], 16, 15, w=8, unit="short", decimals=0, min=0, max=2,
        desc="0 normal, 1 warning, 2 critical.", no_value="Not collected") }},
    {{ m.ts(26, "MLX-LM process memory and CPU", [{"expr": 'max(mlx_process_memory_footprint_bytes{' ~ H ~ '})', "legend": "footprint"}, {"expr": 'max(mlx_process_memory_rss_bytes{' ~ H ~ '})', "legend": "RSS"}, {"expr": 'max(mlx_process_cpu_utilization_percent{' ~ H ~ '})', "legend": "CPU %"}], 0, 23, w=8, unit="bytes",
        desc="Footprint includes Metal buffers; RSS mostly does not. CPU % is ps %cpu (100 = one core).", no_value="Process not found", min=0,
        overrides=[{"matcher": {"id": "byName", "options": "CPU %"}, "properties": [{"id": "unit", "value": "percent"}, {"id": "custom.axisPlacement", "value": "right"}]}]) }},
    {{ m.ts(27, "Disk used (/)", [{"expr": disk_used_pct, "legend": "used %"}], 8, 23, w=8, unit="percent", min=0, max=100, desc="Existing host metrics.") }},
    {{ m.ts(28, "GPU utilisation", [{"expr": 'max(macos_gpu_utilization_percent{' ~ H ~ '})', "legend": "device"}, {"expr": 'max(macos_gpu_renderer_utilization_percent{' ~ H ~ '})', "legend": "renderer"}], 16, 23, w=8, unit="percent", min=0, max=100,
        desc="IORegistry PerformanceStatistics.", no_value="Not collected") }},
    {{ m.ts(29, "GPU / unified memory", [{"expr": 'max(macos_gpu_memory_in_use_bytes{' ~ H ~ '})', "legend": "in use"}, {"expr": 'max(macos_gpu_memory_allocated_bytes{' ~ H ~ '})', "legend": "allocated"}], 0, 31, w=8, unit="bytes", min=0,
        desc="IORegistry PerformanceStatistics.", no_value="Not collected") }},
    {{ m.ts(30, "Thermal state", [{"expr": 'max(macos_thermal_state{' ~ H ~ '})', "legend": "thermal state"}], 8, 31, w=8, unit="short", decimals=0, min=0, max=3,
        desc="0 nominal, 1 fair, 2 serious, 3 critical.", no_value="Not collected") }},
    {{ m.text(31, "GPU frequency and power", "**Not collected.** GPU frequency and CPU / GPU / ANE power come from `powermetrics`, which requires root, or from the private IOReport API. This deployment runs without sudo and uses only supported, unprivileged sources, so these readings are left unavailable rather than estimated.", 16, 31, w=8, h=8) }},

    {{ m.row(32, "LLM performance on this node", 39) }},
    {{ m.ts(33, "Requests per minute by outcome", [{"expr": 'sum by (outcome) (rate(mlx_requests_total{' ~ F ~ '}' ~ ri ~ ')) * 60', "legend": m.lg('outcome')}], 0, 40, w=8, unit="reqpm", stack=true, min=0,
        desc="Requests through the telemetry proxy.", no_value="No proxy telemetry") }},
    {{ m.ts(34, "Time to first token", [{"expr": hq(0.5, 'mlx_time_to_first_token_seconds'), "legend": "p50"}, {"expr": hq(0.95, 'mlx_time_to_first_token_seconds'), "legend": "p95"}], 8, 40, w=8, unit="s", min=0,
        desc="Streaming requests: request start to first generated content event.", no_value="No streaming requests") }},
    {{ m.ts(35, "Generation duration", [{"expr": hq(0.5, 'mlx_generation_duration_seconds'), "legend": "p50"}, {"expr": hq(0.95, 'mlx_generation_duration_seconds'), "legend": "p95"}], 16, 40, w=8, unit="s", min=0,
        desc="Streaming requests: first generated content to end of stream.", no_value="No streaming requests") }},
    {{ m.ts(36, "Tokens per minute", [{"expr": 'sum(rate(mlx_tokens_prompt_total{' ~ F ~ '}' ~ ri ~ ')) * 60', "legend": "prompt"}, {"expr": 'sum(rate(mlx_tokens_completion_total{' ~ F ~ '}' ~ ri ~ ')) * 60', "legend": "completion"}], 0, 48, w=8, unit="short", min=0,
        desc="From MLX-LM usage blocks.", no_value="No proxy telemetry") }},
    {{ m.ts(37, "Completion tokens/s per request", [{"expr": hq(0.5, 'mlx_completion_tokens_per_second'), "legend": "p50"}, {"expr": hq(0.95, 'mlx_completion_tokens_per_second'), "legend": "p95"}], 8, 48, w=8, unit="short", min=0,
        desc="(completion_tokens - 1) / generation duration, streaming requests with usage.", no_value="No streaming requests") }},
    {{ m.ts(38, "Active requests", [{"expr": 'sum(mlx_requests_active{' ~ H ~ '})', "legend": "active"}], 16, 48, w=8, unit="short", decimals=0, min=0,
        desc="Requests in flight through the proxy.", no_value="No proxy telemetry") }},
    {{ m.ts(39, "Errors by status", [{"expr": 'sum by (status_code, outcome) (increase(mlx_requests_total{' ~ F ~ ', outcome!="success"}' ~ ri ~ '))', "legend": m.lg('status_code') ~ " " ~ m.lg('outcome')}], 0, 56, w=8, unit="short", min=0, draw="bars",
        desc="Failed requests per interval.", no_value="No proxy telemetry") }},
    {{ m.ts(40, "Streaming vs non-streaming", [{"expr": 'sum by (stream) (rate(mlx_requests_total{' ~ F ~ '}' ~ ri ~ ')) * 60', "legend": "stream=" ~ m.lg('stream')}], 8, 56, w=8, unit="reqpm", stack=true, min=0,
        desc="By the request's stream flag.", no_value="No proxy telemetry") }},
    {{ m.ts(41, "Context used per request", [{"expr": hq(0.5, 'mlx_request_context_tokens'), "legend": "p50"}, {"expr": hq(0.95, 'mlx_request_context_tokens'), "legend": "p95"}, {"expr": 'max(mlx_model_context_length_max{' ~ H ~ '})', "legend": "model max"}], 16, 56, w=8, unit="short", min=0,
        desc="Prompt + completion tokens per request, and the model's maximum context when known. KV-cache size and utilisation are not exposed by mlx_lm.server.", no_value="No usage reported") }},

    {{ m.row(42, "Troubleshooting", 64) }},
    {{ m.ts(43, "Request failures over time", [{"expr": 'sum by (outcome) (increase(mlx_requests_total{' ~ F ~ ', outcome!="success"}' ~ ri ~ '))', "legend": m.lg('outcome')}], 0, 65, w=8, unit="short", min=0, draw="bars",
        desc="client_error = 4xx from MLX-LM, server_error = 5xx, upstream_error = proxy could not reach/read MLX-LM, timeout, client_disconnected.", no_value="No proxy telemetry") }},
    {{ m.ts(44, "Latency spikes", [{"expr": hq(0.99, 'mlx_request_duration_seconds'), "legend": "end-to-end p99"}, {"expr": hq(0.99, 'mlx_time_to_first_token_seconds'), "legend": "TTFT p99"}], 8, 65, w=8, unit="s", min=0,
        desc="99th percentiles from histogram buckets; spikes stand out against the p50/p95 panels above.", no_value="No proxy telemetry") }},
    {{ m.ts(45, "MLX-LM restarts", [{"expr": 'sum(increase(mlx_process_restarts_total{' ~ H ~ '}' ~ ri ~ '))', "legend": "pid changes"}, {"expr": 'max(changes(mlx_process_launchd_runs{' ~ H ~ '}' ~ ri ~ '))', "legend": "launchd runs changes"}], 16, 65, w=8, unit="short", min=0, decimals=0, draw="bars",
        desc="Observed pid changes of the MLX-LM process, and changes of launchd's run count when mlx_launchagent_label is set.", no_value="No LLM telemetry") }},
    {{ m.ts(46, "Health check failures", [{"expr": 'sum by (check) (increase(mlx_health_check_failures_total{' ~ H ~ '}' ~ ri ~ '))', "legend": m.lg('check')}, {"expr": '1 - max(mlx_server_up{' ~ H ~ '})', "legend": "/health down (1)"}], 0, 73, w=8, unit="short", min=0,
        desc="Failed checks per interval: http = /health, models = /v1/models, inference = optional probe.", no_value="No LLM telemetry") }},
    {{ m.ts(47, "Memory pressure during inference", [{"expr": 'max(macos_memory_pressure_level{' ~ H ~ '})', "legend": "pressure level"}, {"expr": 'sum(mlx_requests_active{' ~ H ~ '})', "legend": "active requests"}], 8, 73, w=8, unit="short", min=0, decimals=0,
        desc="Pressure level (0-2) against requests in flight.", no_value="No LLM telemetry") }},
    {{ m.ts(48, "Memory, process footprint and latency", [{"expr": mem_used_pct, "legend": "system memory used %"}, {"expr": 'max(mlx_process_memory_footprint_bytes{' ~ H ~ '})', "legend": "MLX-LM footprint"}, {"expr": hq(0.95, 'mlx_request_duration_seconds'), "legend": "request p95"}], 16, 73, w=8, unit="percent", min=0,
        desc="Correlate memory growth with request latency on one time axis.", no_value="No LLM telemetry",
        overrides=[{"matcher": {"id": "byName", "options": "MLX-LM footprint"}, "properties": [{"id": "unit", "value": "bytes"}, {"id": "custom.axisPlacement", "value": "right"}]},
                   {"matcher": {"id": "byName", "options": "request p95"}, "properties": [{"id": "unit", "value": "s"}, {"id": "custom.axisPlacement", "value": "right"}]}]) }}
  ]
}
